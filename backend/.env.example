# MinutelyAI Backend — Environment Variables. Copy this file to .env and fill in your actual values. Never commit .env to version control.

# DeepSeek V3 API key — sign up at platform.deepseek.com, ~$0.0004 per meeting
DEEPSEEK_API_KEY=your_deepseek_key_from_platform.deepseek.com

# Notion integration secret — create at notion.so/my-integrations
NOTION_API_KEY=your_notion_integration_secret

# ID of the Notion page where meeting exports will be created — found in the page URL
NOTION_PARENT_PAGE_ID=your_32_character_notion_page_id
